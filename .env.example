# LVT-EG environment variables - copy to .env and edit.

# Where datasets live (sub-folders per dataset created by download_data.py)
LVT_DATA_DIR=./data

# Where checkpoints + logs are saved
LVT_OUTPUT_DIR=./results

# Optional: pretrained checkpoint base (HuggingFace Hub or local path)
LVT_PRETRAINED_BASE=

# Colab convenience (auto-detected if /content exists, this overrides)
LVT_COLAB=0
